# ---------------------------------------------------------------------------
# IDEA Atlas - example environment file.
# Copy to `.env` and edit. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Application
IDEA_ATLAS_ENV=development           # development | test | production
IDEA_ATLAS_DEBUG=true
IDEA_ATLAS_LOG_LEVEL=INFO
IDEA_ATLAS_LOG_JSON=false            # true for structured JSON logs (production)

# Database
IDEA_ATLAS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/idea_atlas
IDEA_ATLAS_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/idea_atlas_test

# API server
IDEA_ATLAS_API_HOST=127.0.0.1
IDEA_ATLAS_API_PORT=8000

# CORS - explicit allowlist. Empty means "no cross-origin browser access".
# Comma-separated, e.g. https://research.example.org,https://admin.example.org
IDEA_ATLAS_CORS_ORIGINS=

# Request hardening
IDEA_ATLAS_MAX_REQUEST_BYTES=1048576     # 1 MiB cap on request bodies

# ---------------------------------------------------------------------------
# Ingestion safety limits (see docs/SECURITY.md)
# ---------------------------------------------------------------------------
IDEA_ATLAS_INGEST_MAX_RESPONSE_BYTES=26214400   # 25 MiB hard cap per document
IDEA_ATLAS_INGEST_TIMEOUT_SECONDS=30
IDEA_ATLAS_INGEST_MAX_RETRIES=3
IDEA_ATLAS_INGEST_USER_AGENT=idea-atlas/0.1 (+https://github.com/kgarner310/idea-atlas)
# Set to false ONLY in a controlled test harness. Live ingestion must keep the
# domain allowlist on: it is the primary SSRF control.
IDEA_ATLAS_INGEST_ENFORCE_ALLOWLIST=true

# ---------------------------------------------------------------------------
# AI providers - OPTIONAL. The system is fully functional with provider=null.
# No key is required to run the API, the tests, or ingestion.
# ---------------------------------------------------------------------------
IDEA_ATLAS_AI_PROVIDER=null          # null | anthropic | openai | gemini | ollama
IDEA_ATLAS_AI_MODEL=
IDEA_ATLAS_AI_BASE_URL=              # e.g. http://localhost:11434 for Ollama
# API keys are read from the provider's own conventional variable so that this
# file never has to hold one:
#   ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY
